# ==============================================================================
# Security Scanner Engine Configuration
# ==============================================================================

# Docker Hub Username (used for tagging and pushing container images)
DOCKER_HUB_USER=your_dockerhub_username

# Gemini LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini

# Automatically translates localhost / 127.0.0.1 target URLs to host.docker.internal
# so the scanner container can reach apps running on the host machine
AUTO_MAP_LOCALHOST_TO_HOST_DOCKER_INTERNAL=true

# MongoDB URI (Points to your local MongoDB on Windows host)
SPRING_DATA_MONGODB_URI=mongodb://host.docker.internal:27017/security_engine_db
